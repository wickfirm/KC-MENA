import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { LEGAL_PAGE_TITLES, LEGAL_SLUGS, parseLegacyLegalHtml } from "../src/lib/legal-parse.ts";

const root = process.cwd();
const defaults: Record<string, unknown> = {};

for (const slug of LEGAL_SLUGS) {
  const html = readFileSync(join(root, "reference", slug, "index.html"), "utf8");
  const title = html.match(/<section class="legal-hero">[\s\S]*?<h1>([\s\S]*?)<\/h1>/)?.[1]?.trim() ?? LEGAL_PAGE_TITLES[slug];
  const eyebrow = html.match(/<section class="legal-hero">[\s\S]*?<span class="eyebrow">([\s\S]*?)<\/span>/)?.[1]?.trim() ?? "Legal";
  const meta = html.match(/<aside class="legal-meta">([\s\S]*?)<\/aside>/)?.[1] ?? "";
  const body = html.match(/<div class="legal-body">([\s\S]*?)\s*<\/div>\s*<\/div>\s*<\/section>/)?.[1] ?? "";
  const description = html.match(/<meta name="description" content="([\s\S]*?)">/)?.[1] ?? "";
  if (!body) throw new Error(`Could not read the legal body for ${slug}`);
  defaults[slug] = { ...parseLegacyLegalHtml(meta, body, title, eyebrow), description };
}

writeFileSync(join(root, "src", "lib", "legal-defaults.json"), JSON.stringify(defaults, null, 2) + "\n", "utf8");

const rows = LEGAL_SLUGS.map((slug) => {
  const entry = defaults[slug] as { title: string; description: string };
  const { description, ...content } = entry as { description: string } & Record<string, unknown>;
  const seo = JSON.stringify({ title: `${entry.title} | Kasumigaseki MENA`, description });
  return `('${slug}', $page$${entry.title}$page$, 'published', $page$${JSON.stringify(content)}$page$::jsonb, $page$${seo}$page$::jsonb)`;
});

const sql = `-- Legal pages: structured fields taken from reference/ (privacy-policy, terms-and-conditions, cookie-policy, legal-notice).
-- Generated by scripts/build-legal-content.mjs. Existing rows are never overwritten.
INSERT INTO pages (slug, title, status, content, seo)
VALUES
${rows.join(",\n")}
ON CONFLICT (slug) DO NOTHING;
`;
writeFileSync(join(root, "db", "seed-pages.sql"), sql, "utf8");
console.log(`Wrote structured legal defaults for ${LEGAL_SLUGS.length} pages.`);
for (const slug of LEGAL_SLUGS) {
  const entry = defaults[slug] as { title: string; sections: unknown[] };
  console.log(`  - ${slug}: "${entry.title}" (${entry.sections.length} sections)`);
}
